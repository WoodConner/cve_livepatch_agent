#!/usr/bin/env python3
"""
Skill: 补丁验证
验证补丁的语法、语义和 kpatch 兼容性
"""

import sys
import os
import subprocess
import argparse
from pathlib import Path


def check_patch_syntax(patch_file):
    """检查补丁语法"""
    print("  → 检查补丁语法...")

    with open(patch_file) as f:
        content = f.read()

    # 检查基本格式
    if not ('diff --git' in content or '--- a/' in content):
        print("    ❌ 不是有效的 unified diff 格式")
        return False

    # 检查是否有实际修改
    if not ('+' in content or '-' in content):
        print("    ❌ 补丁没有实际修改")
        return False

    print("    ✅ 补丁语法正确")
    return True


def check_patch_applies(patch_file, kernel_src):
    """检查补丁是否可以应用"""
    print("  → 检查补丁是否可应用...")

    if not os.path.exists(kernel_src):
        print(f"    ⚠️  内核源码不存在: {kernel_src}")
        return None

    try:
        # 使用 git apply --check 测试
        result = subprocess.run(
            ['git', 'apply', '--check', patch_file],
            cwd=kernel_src,
            capture_output=True,
            text=True,
            timeout=10
        )

        if result.returncode == 0:
            print("    ✅ 补丁可以应用")
            return True
        else:
            print("    ❌ 补丁无法应用")
            if result.stderr:
                print(f"    错误: {result.stderr[:200]}")
            return False
    except Exception as e:
        print(f"    ⚠️  检查失败: {e}")
        return None


def analyze_patch_changes(patch_file):
    """分析补丁修改内容"""
    print("  → 分析补丁修改...")

    with open(patch_file) as f:
        lines = f.readlines()

    stats = {
        'files_changed': set(),
        'functions_modified': set(),
        'lines_added': 0,
        'lines_removed': 0,
        'has_init_changes': False,
        'has_data_changes': False
    }

    current_file = None

    for line in lines:
        # 提取文件名
        if line.startswith('--- a/') or line.startswith('+++ b/'):
            file_path = line.split('/', 1)[1].strip()
            if file_path != '/dev/null':
                stats['files_changed'].add(file_path)
                current_file = file_path

        # 统计修改行数
        elif line.startswith('+') and not line.startswith('+++'):
            stats['lines_added'] += 1
        elif line.startswith('-') and not line.startswith('---'):
            stats['lines_removed'] += 1

        # 检测函数修改
        if line.startswith('@@'):
            # 提取函数名
            import re
            match = re.search(r'@@.*@@\s*(\w+)', line)
            if match:
                stats['functions_modified'].add(match.group(1))

        # 检测 __init 修改
        if '__init' in line or '__exit' in line:
            stats['has_init_changes'] = True

        # 检测数据段修改
        if 'static' in line and ('=' in line or 'struct' in line):
            stats['has_data_changes'] = True

    print(f"    文件修改: {len(stats['files_changed'])} 个")
    for f in list(stats['files_changed'])[:5]:
        print(f"      - {f}")

    print(f"    函数修改: {len(stats['functions_modified'])} 个")
    for func in list(stats['functions_modified'])[:5]:
        print(f"      - {func}()")

    print(f"    行数变化: +{stats['lines_added']} -{stats['lines_removed']}")

    if stats['has_init_changes']:
        print("    ⚠️  包含初始化函数修改")

    if stats['has_data_changes']:
        print("    ⚠️  包含静态数据修改")

    return stats


def check_kpatch_compatibility(patch_file, stats):
    """检查 kpatch 兼容性"""
    print("  → 检查 kpatch 兼容性...")

    issues = []

    if stats['has_init_changes']:
        issues.append("包含初始化函数修改（kpatch 不支持）")

    if stats['has_data_changes']:
        issues.append("包含静态数据修改（可能不兼容）")

    if len(stats['functions_modified']) > 10:
        issues.append(f"修改函数过多 ({len(stats['functions_modified'])} 个)")

    if issues:
        print("    ⚠️  发现潜在兼容性问题:")
        for issue in issues:
            print(f"      - {issue}")
        return False
    else:
        print("    ✅ 未发现明显兼容性问题")
        return True


def main():
    parser = argparse.ArgumentParser(description='补丁验证工具')
    parser.add_argument('patch_file', help='补丁文件路径')
    parser.add_argument('--kernel-src', default='/usr/src/kernels', help='内核源码路径')
    parser.add_argument('--full', action='store_true', help='完整验证（包括应用测试）')

    args = parser.parse_args()

    print(f"🔍 验证补丁: {args.patch_file}")
    print("=" * 60)

    if not os.path.exists(args.patch_file):
        print(f"❌ 补丁文件不存在: {args.patch_file}")
        return 1

    # 1. 语法检查
    print("\n[1/4] 语法检查")
    if not check_patch_syntax(args.patch_file):
        return 1

    # 2. 内容分析
    print("\n[2/4] 内容分析")
    stats = analyze_patch_changes(args.patch_file)

    # 3. 兼容性检查
    print("\n[3/4] 兼容性检查")
    compatible = check_kpatch_compatibility(args.patch_file, stats)

    # 4. 应用测试（可选）
    if args.full:
        print("\n[4/4] 应用测试")
        check_patch_applies(args.patch_file, args.kernel_src)
    else:
        print("\n[4/4] 应用测试（跳过，使用 --full 启用）")

    print("\n" + "=" * 60)
    if compatible:
        print("✅ 验证通过")
        return 0
    else:
        print("⚠️  验证完成，但发现潜在问题")
        return 0


if __name__ == '__main__':
    sys.exit(main())
